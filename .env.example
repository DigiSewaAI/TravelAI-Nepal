APP_NAME="TravelAI Nepal"
APP_ENV=local
APP_TIMEZONE=UTC
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# SMS
SMS_GATEWAY=twilio

# Twilio (optional — only if SMS gateway is enabled)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Nepal SMS (optional — only if Nepal SMS gateway is enabled)
NEPAL_SMS_API_KEY=
NEPAL_SMS_SENDER_ID=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Session / Cookies
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE: leave empty locally; set to `true` in production (HTTPS-only)
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_DRIVER=file          # Legacy key (Laravel 11+ uses CACHE_STORE)
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (S3 — optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── TravelAI Nepal — Application-specific ─────────────────────────────
# Never commit real values. Leave empty in this template.

OPENWEATHER_API_KEY=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# ========== AI Providers (Phase 4J) ==========
# Priority: Groq → OpenRouter → Cerebras
# Multi-key: comma-separate in *_API_KEYS

GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

CEREBRAS_API_KEY=
CEREBRAS_API_KEYS=
CEREBRAS_MODEL=llama3.1-8b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

AI_FALLBACK_ENABLED=true
AI_PROVIDER=

EXCHANGE_RATE_USD_NPR=

TRAVELAI_LOCATION_FILTERING_ENABLED=
TRAVELAI_QUALITY_THRESHOLD=
TRAVELAI_MAX_RECOMMENDATIONS=

FFMPEG_BINARIES=
FFPROBE_BINARIES=

VITE_APP_NAME="${APP_NAME}"
