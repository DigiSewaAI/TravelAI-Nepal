# ════════════════════════════════════════════════════════════════════════
# TravelAI Nepal — Production Environment Template
# ════════════════════════════════════════════════════════════════════════
#
# HOW TO USE
#   1. Copy this file to `.env.production` on the production server
#   2. Fill in real secret values (never commit them)
#   3. Run `php artisan config:cache` after edits
#
# NEVER commit `.env.production` or its real secrets to version control.
# `.env.production` is already covered by `.gitignore`.
#
# See: docs/deployment/PRODUCTION_ENV.md for the full guide.
# ════════════════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────────────────
APP_NAME="TravelAI Nepal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-production-domain.example
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# ─── Logging ───────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=14

# ─── Database ──────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ─── Session / Cookies ─────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ─── Cache / Queue ─────────────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Mail ──────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-production-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# ─── TravelAI Nepal — Required Integrations ────────────────────────────
OPENWEATHER_API_KEY=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
GROQ_API_KEY=
GROQ_MODEL=
AI_PROVIDER=

EXCHANGE_RATE_USD_NPR=

TRAVELAI_LOCATION_FILTERING_ENABLED=true
TRAVELAI_QUALITY_THRESHOLD=
TRAVELAI_MAX_RECOMMENDATIONS=

FFMPEG_BINARIES=
FFPROBE_BINARIES=

# ─── Optional / If-enabled Services ────────────────────────────────────
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

NEPAL_SMS_API_KEY=
NEPAL_SMS_SENDER_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"