# ============================================
# TravelAI Nepal — PRODUCTION ENVIRONMENT TEMPLATE
# ============================================
# Copy this file to `.env` on production servers
# and fill in real values. NEVER commit the real .env.
# ============================================

APP_NAME="TravelAI Nepal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kathmandu
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# --------------------------------------------
# LOGGING (production: warning, not debug)
# --------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

# --------------------------------------------
# DATABASE
# --------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=travelai_db
DB_USERNAME=
DB_PASSWORD=

# --------------------------------------------
# SESSION / CACHE / QUEUE
# --------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=database

# --------------------------------------------
# FILESYSTEM
# --------------------------------------------
FILESYSTEM_DISK=public

# --------------------------------------------
# MAIL (fill real SMTP on deployment)
# --------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------
# THIRD-PARTY SERVICES (fill on deployment)
# --------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

OPENWEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=

# --------------------------------------------
# SMS (optional)
# --------------------------------------------
SMS_GATEWAY=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --------------------------------------------
# LOCALIZATION / OTHER
# --------------------------------------------
APP_PREVIOUS_KEYS=
EXCHANGE_RATE_USD_NPR=152.60